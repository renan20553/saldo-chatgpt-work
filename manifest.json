{
  "manifest_version": 3,
  "name": "Saldo ChatGPT Work",
  "version": "1.1.1",
  "incognito": "split",
  "minimum_chrome_version": "110",
  "description": "Mostra o percentual restante dos limites compartilhados do ChatGPT Work e Codex.",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Saldo ChatGPT Work",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
